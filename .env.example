# Copiá este archivo como .env.local para desarrollo local.

# Base de datos Postgres (Neon). En Vercel la completa sola la integración de Neon.
# Si se deja vacía en local, se usa una base embebida (PGlite) guardada en ./.data/pglite
DATABASE_URL=

# Clave para firmar las sesiones. Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Primer usuario administrador: se crea solo si la tabla de usuarios está vacía.
# Después de ingresar, creá los usuarios del equipo desde la pestaña "Usuarios".
ADMIN_EMAIL=admin@mesadeayuda.local
ADMIN_PASSWORD=

# Poné "false" para arrancar con la base vacía (sin empresas, llamadas ni respuestas de ejemplo).
SEED_DEMO=true
